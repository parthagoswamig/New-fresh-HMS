generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  HR_MANAGER
  ACCOUNTANT
  FINANCE_MANAGER
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
  DECEASED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum BillingStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  UPI
  BANK_TRANSFER
  CHEQUE
  INSURANCE
}

enum TestStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

// Old ClaimStatus enum removed - now using the new one below for InsuranceClaim model

// ==================== TENANT ====================
model Tenant {
  id            String   @id @default(cuid())
  name          String
  subdomain     String   @unique
  email         String
  phone         String
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  patients      Patient[]
  staff         Staff[]
  appointments  Appointment[]
  departments   Department[]
  beds          Bed[]
  wards         Ward[]
  medicines     Medicine[]
  labTests      LabTest[]
  bills         Bill[]
  insurances    Insurance[]
  settings      Setting[]
  opdVisits     OPDVisit[]
  ipdAdmissions IPDAdmission[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  labEntries    LabEntry[]
  radiologyTests RadiologyTest[]
  patientRadiology PatientRadiology[]
  insuranceCompanies InsuranceCompany[]
  insurancePolicies InsurancePolicy[]
  patientInsurances PatientInsurance[]
  insuranceClaims InsuranceClaim[]
  financeTransactions FinanceTransaction[]
  financeBudgets FinanceBudget[]
  operatingRooms OperatingRoom[]
  surgeries Surgery[]
  emergencyCases EmergencyCase[]
  suppliers Supplier[]
  inventoryItems InventoryItem[]
  stockBatches StockBatch[]
  purchaseOrders PurchaseOrder[]
  requisitions Requisition[]
  stockTransfers StockTransfer[]
  stockAdjustments StockAdjustment[]

  @@map("tenants")
}

// ==================== USER & AUTH ====================
model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String
  password      String
  role          Role
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff         Staff?
  patient       Patient?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ==================== STAFF ====================
model Staff {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String   @unique
  employeeId      String
  departmentId    String?
  specialization  String?
  qualification   String?
  experience      Int?
  dateOfJoining   DateTime
  dateOfBirth     DateTime?
  gender          Gender?
  address         String?
  emergencyContact String?
  salary          Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id])
  appointments    Appointment[]
  opdVisits       OPDVisit[]
  ipdAdmissions   IPDAdmission[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  attendances     Attendance[]
  labEntriesCreated LabEntry[] @relation("LabEntryCreatedBy")
  labReports      LabReport[]  @relation("LabReportReportedBy")
  radiologyCreated PatientRadiology[] @relation("RadiologyCreatedBy")
  claimsCreated   InsuranceClaim[] @relation("ClaimCreatedBy")
  financeTransactions FinanceTransaction[]
  financeTransactionsCreated FinanceTransaction[] @relation("FinanceCreatedBy")
  financeBudgets  FinanceBudget[]
  surgeriesAsSurgeon Surgery[] @relation("SurgerySurgeon")
  surgeriesAsAnesthesiologist Surgery[] @relation("SurgeryAnesthesiologist")
  surgeriesCreated Surgery[] @relation("SurgeryCreatedBy")
  surgeriesCancelled Surgery[] @relation("SurgeryCancelledBy")
  emergenciesAsFirstResponder EmergencyCase[] @relation("EmergencyFirstResponder")
  emergenciesAsTriageNurse EmergencyCase[] @relation("EmergencyTriageNurse")
  emergenciesAsAttendingDoctor EmergencyCase[] @relation("EmergencyAttendingDoctor")
  emergencyCasesCreated EmergencyCase[] @relation("EmergencyCreatedBy")
  emergencyCasesUpdated EmergencyCase[] @relation("EmergencyUpdatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("POApprovedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("POCreatedBy")
  requisitionsRequested Requisition[] @relation("RequisitionRequestedBy")
  requisitionsApproved Requisition[] @relation("RequisitionApprovedBy")
  requisitionsIssued Requisition[] @relation("RequisitionIssuedBy")
  transfersRequested StockTransfer[] @relation("TransferRequestedBy")
  transfersApproved StockTransfer[] @relation("TransferApprovedBy")
  stockAdjustments StockAdjustment[] @relation("AdjustmentBy")

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("staff")
}

// ==================== PATIENT ====================
model Patient {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String?       @unique
  patientId         String
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  phone             String
  email             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  emergencyContact  String?
  bloodGroup        String?
  maritalStatus     String?
  allergies         String?
  status            PatientStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id])
  appointments      Appointment[]
  opdVisits         OPDVisit[]
  ipdAdmissions     IPDAdmission[]
  bills             Bill[]
  insurances        Insurance[]
  labOrders         LabOrder[]
  labEntries        LabEntry[]
  radiologyTests    PatientRadiology[]
  patientInsurances PatientInsurance[]
  insuranceClaims   InsuranceClaim[]
  financeTransactions FinanceTransaction[]
  surgeries         Surgery[]
  emergencyCases    EmergencyCase[]

  @@unique([tenantId, patientId])
  @@index([tenantId])
  @@map("patients")
}

// ==================== DEPARTMENT ====================
model Department {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff         Staff[]
  opdVisits     OPDVisit[]
  ipdAdmissions IPDAdmission[]
  stockBatches  StockBatch[]
  requisitions  Requisition[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

// ==================== APPOINTMENT ====================
model Appointment {
  id              String   @id @default(cuid())
  tenantId        String
  patientId       String
  doctorId        String
  appointmentDate DateTime
  appointmentTime String
  status          String   @default("PENDING")
  reason          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id])
  doctor          Staff    @relation(fields: [doctorId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

// ==================== OPD ====================
model OPDVisit {
  id              String   @id @default(cuid())
  tenantId        String
  patientId       String
  doctorId        String
  departmentId    String?
  visitDate       DateTime @default(now())
  chiefComplaint  String
  diagnosis       String?
  notes           String?
  vitals          Json?
  fee             Float    @default(0)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])
  doctor          Staff          @relation(fields: [doctorId], references: [id])
  department      Department?    @relation(fields: [departmentId], references: [id])
  prescriptions   Prescription[]
  labOrders       LabOrder[]

  @@index([tenantId])
  @@index([patientId])
  @@map("opd_visits")
}

// ==================== IPD ====================
model Ward {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  floor       String?
  capacity    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beds        Bed[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("wards")
}

model Bed {
  id              String   @id @default(cuid())
  tenantId        String
  wardId          String
  bedNumber       String
  bedType         String
  isOccupied      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward            Ward           @relation(fields: [wardId], references: [id])
  ipdAdmissions   IPDAdmission[]

  @@unique([tenantId, wardId, bedNumber])
  @@index([tenantId])
  @@map("beds")
}

model IPDAdmission {
  id                String          @id @default(cuid())
  tenantId          String
  patientId         String
  doctorId          String
  departmentId      String?
  bedId             String?
  admissionDate     DateTime        @default(now())
  dischargeDate     DateTime?
  status            String          @default("ADMITTED")
  admissionReason   String
  diagnosis         String?
  treatmentPlan     String?
  roomNumber        String?
  bedNumber         String?
  dischargeSummary  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient         @relation(fields: [patientId], references: [id])
  doctor            Staff           @relation(fields: [doctorId], references: [id])
  department        Department?     @relation(fields: [departmentId], references: [id])
  bed               Bed?            @relation(fields: [bedId], references: [id])
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  emergencyCases    EmergencyCase[]

  @@index([tenantId])
  @@index([patientId])
  @@map("ipd_admissions")
}

// ==================== PRESCRIPTION ====================
model Prescription {
  id              String              @id @default(cuid())
  tenantId        String
  opdVisitId      String?
  ipdAdmissionId  String?
  doctorId        String
  prescriptionDate DateTime           @default(now())
  status          PrescriptionStatus  @default(PENDING)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opdVisit        OPDVisit?           @relation(fields: [opdVisitId], references: [id])
  ipdAdmission    IPDAdmission?       @relation(fields: [ipdAdmissionId], references: [id])
  doctor          Staff               @relation(fields: [doctorId], references: [id])
  items           PrescriptionItem[]

  @@index([tenantId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String       @id @default(cuid())
  prescriptionId  String
  medicineId      String
  dosage          String
  frequency       String
  duration        String
  instructions    String?
  quantity        Int
  createdAt       DateTime     @default(now())

  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine        Medicine     @relation(fields: [medicineId], references: [id])

  @@map("prescription_items")
}

// ==================== PHARMACY ====================
model Medicine {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  genericName       String?
  manufacturer      String?
  category          String?
  batchNumber       String?
  expiryDate        DateTime?
  stockQuantity     Int                @map("stockQuantity")
  unitPrice         Float              @map("unitPrice")
  reorderLevel      Int                @default(10)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, name, batchNumber])
  @@index([tenantId])
  @@map("medicines")
}

// ==================== LABORATORY ====================
model LabTest {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String?
  price       Float
  description String?
  unit        String?
  referenceRange String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  labOrders   LabOrder[]
  entryItems  LabEntryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("lab_tests")
}

model LabOrder {
  id              String          @id @default(cuid())
  tenantId        String
  patientId       String
  opdVisitId      String?
  ipdAdmissionId  String?
  labTestId       String
  orderedById     String
  testName        String
  testCode        String?
  sampleType      String?
  orderDate       DateTime        @default(now())
  status          TestStatus      @default(ORDERED)
  result          String?
  unit            String?
  referenceRange  String?
  resultDate      DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id])
  opdVisit        OPDVisit?       @relation(fields: [opdVisitId], references: [id])
  ipdAdmission    IPDAdmission?   @relation(fields: [ipdAdmissionId], references: [id])
  labTest         LabTest         @relation(fields: [labTestId], references: [id])
  orderedBy       Staff           @relation(fields: [orderedById], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@map("lab_orders")
}

model LabEntry {
  id              String      @id @default(cuid())
  tenantId        String
  patientId       String
  entryNumber     String
  totalAmount     Float
  status          TestStatus  @default(ORDERED)
  sampleType      String?
  notes           String?
  billedToFinal   Boolean     @default(false)
  billId          String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient     @relation(fields: [patientId], references: [id])
  createdBy       Staff       @relation("LabEntryCreatedBy", fields: [createdById], references: [id])
  bill            Bill?       @relation(fields: [billId], references: [id])
  items           LabEntryItem[]
  report          LabReport?

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([patientId])
  @@map("lab_entries")
}

model LabEntryItem {
  id              String    @id @default(cuid())
  labEntryId      String
  labTestId       String
  testName        String
  price           Float
  result          String?
  unit            String?
  referenceRange  String?
  status          TestStatus @default(ORDERED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  labEntry        LabEntry  @relation(fields: [labEntryId], references: [id], onDelete: Cascade)
  labTest         LabTest   @relation(fields: [labTestId], references: [id])

  @@map("lab_entry_items")
}

model LabReport {
  id              String    @id @default(cuid())
  labEntryId      String    @unique
  comments        String?
  findings        String?
  interpretation  String?
  printed         Boolean   @default(false)
  printedAt       DateTime?
  reportedById    String
  reportedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  labEntry        LabEntry  @relation(fields: [labEntryId], references: [id], onDelete: Cascade)
  reportedBy      Staff     @relation("LabReportReportedBy", fields: [reportedById], references: [id])

  @@map("lab_reports")
}

// ==================== BILLING ====================
model Bill {
  id                String        @id @default(cuid())
  tenantId          String
  patientId         String
  billNumber        String
  billDate          DateTime      @default(now())
  totalAmount       Float
  paidAmount        Float         @default(0)
  discountAmount    Float         @default(0)
  insuranceCovered  Float         @default(0)
  status            BillingStatus @default(PENDING)
  dueDate           DateTime?
  notes             String?
  finalized         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id])
  items             BillItem[]
  payments          Payment[]
  labEntries        LabEntry[]
  insuranceClaims   InsuranceClaim[]
  surgeries         Surgery[]
  emergencyCases    EmergencyCase[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([patientId])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  description String
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  amount      Float
  createdAt   DateTime @default(now())

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_items")
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  paymentDate     DateTime      @default(now())
  amount          Float
  paymentMethod   PaymentMethod
  transactionId   String?
  notes           String?
  createdAt       DateTime      @default(now())

  bill            Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ==================== INSURANCE ====================
model Insurance {
  id              String      @id @default(cuid())
  tenantId        String
  patientId       String
  policyNumber    String
  provider        String
  policyType      String?
  coverageAmount  Float
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient     @relation(fields: [patientId], references: [id])
  claims          Claim[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId])
  @@index([patientId])
  @@map("insurances")
}

model Claim {
  id              String      @id @default(cuid())
  insuranceId     String
  claimNumber     String      @unique
  claimDate       DateTime    @default(now())
  claimAmount     Float
  approvedAmount  Float?
  status          String      @default("SUBMITTED")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  insurance       Insurance   @relation(fields: [insuranceId], references: [id])

  @@map("claims")
}

// ==================== HR & PAYROLL ====================
model Attendance {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String
  notes       String?
  createdAt   DateTime @default(now())

  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("attendances")
}

// ==================== SETTINGS ====================
model Setting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("settings")
}

// ==================== RADIOLOGY ====================
model RadiologyTest {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  code            String
  description     String?
  price           Float
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientTests    PatientRadiology[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("radiology_tests")
}

enum RadiologyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PatientRadiology {
  id              String            @id @default(cuid())
  tenantId        String
  patientId       String
  testId          String
  resultSummary   String?
  radiologist     String?
  reportUrl       String?
  status          RadiologyStatus   @default(PENDING)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id])
  radiologyTest   RadiologyTest     @relation(fields: [testId], references: [id])
  createdBy       Staff             @relation("RadiologyCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@map("patient_radiology")
}

// ==================== INSURANCE ====================
model InsuranceCompany {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  address         String?
  city            String?
  state           String?
  zipCode         String?
  phone           String?
  email           String?
  contactPerson   String?
  website         String?
  terms           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies        InsurancePolicy[]

  @@index([tenantId])
  @@map("insurance_companies")
}

model InsurancePolicy {
  id              String              @id @default(cuid())
  tenantId        String
  companyId       String
  policyName      String
  policyNumber    String
  policyType      String              // Health, Life, Accident, etc.
  coveragePercent Float               // e.g., 80 means 80% coverage
  deductible      Float               @default(0)
  maxCoverage     Float?              // Maximum coverage amount
  validFrom       DateTime
  validUntil      DateTime
  terms           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         InsuranceCompany    @relation(fields: [companyId], references: [id])
  patientInsurances PatientInsurance[]
  claims          InsuranceClaim[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId])
  @@index([companyId])
  @@map("insurance_policies")
}

model PatientInsurance {
  id              String              @id @default(cuid())
  tenantId        String
  patientId       String
  policyId        String
  policyNumber    String
  startDate       DateTime
  endDate         DateTime
  coverageAmount  Float?
  remainingCoverage Float?
  status          String              @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id])
  policy          InsurancePolicy     @relation(fields: [policyId], references: [id])

  @@index([tenantId])
  @@index([patientId])
  @@index([policyId])
  @@map("patient_insurance")
}

enum ClaimStatus {
  INITIATED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SETTLED
  CANCELLED
}

model InsuranceClaim {
  id              String              @id @default(cuid())
  tenantId        String
  patientId       String
  policyId        String
  claimNumber     String
  billId          String?
  claimDate       DateTime            @default(now())
  serviceDate     DateTime
  services        Json                // Array of services with costs
  totalAmount     Float
  deductible      Float
  coveredAmount   Float
  patientBalance  Float
  status          ClaimStatus         @default(INITIATED)
  reviewNotes     String?
  approvedBy      String?
  approvedDate    DateTime?
  rejectionReason String?
  documents       Json?               // Array of document URLs
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id])
  policy          InsurancePolicy     @relation(fields: [policyId], references: [id])
  createdBy       Staff               @relation("ClaimCreatedBy", fields: [createdById], references: [id])
  bill            Bill?               @relation(fields: [billId], references: [id])

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([policyId])
  @@index([status])
  @@map("insurance_claims")
}

// ==================== FINANCE MODULE ====================

enum TransactionType {
  INCOME
  EXPENSE
  ADVANCE
  REFUND
}

enum TransactionSource {
  MANUAL
  BILLING
  INSURANCE
  INVENTORY
  PAYROLL
  PHARMACY
  LABORATORY
  RADIOLOGY
  IPD
  OPD
  SURGERY
  REFUND
}

enum FinanceCategory {
  CONSULTATION_FEE
  MEDICINE_SALES
  LAB_TEST
  RADIOLOGY
  SURGERY_FEE
  ROOM_CHARGES
  INSURANCE_REIMBURSEMENT
  SALARY
  RENT
  UTILITIES
  EQUIPMENT
  SUPPLIES
  MAINTENANCE
  MARKETING
  REFUND
  DONATION
  OTHER
}

model FinanceTransaction {
  id              String            @id @default(uuid())
  tenantId        String
  transactionNo   String            // FIN-YYYYMM-0001
  type            TransactionType
  amount          Float
  sourceModule    TransactionSource
  sourceReference String?           // e.g., billId, invoiceId, salaryId
  reason          String
  description     String?
  paymentMethod   PaymentMethod
  category        FinanceCategory
  tags            String[]          @default([])
  date            DateTime          @default(now())
  attachments     Json?             // Array of file URLs
  metadata        Json?             // Additional data from source module
  
  // Optional links
  patientId       String?
  staffId         String?
  
  // Audit
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient?          @relation(fields: [patientId], references: [id])
  staff           Staff?            @relation(fields: [staffId], references: [id])
  createdBy       Staff             @relation("FinanceCreatedBy", fields: [createdById], references: [id])
  
  @@unique([tenantId, transactionNo])
  @@index([tenantId])
  @@index([type])
  @@index([sourceModule])
  @@index([date])
  @@index([category])
  @@map("finance_transactions")
}

model FinanceBudget {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  category    FinanceCategory
  amount      Float
  period      String          // MONTHLY, QUARTERLY, YEARLY
  startDate   DateTime
  endDate     DateTime
  spent       Float           @default(0)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Staff           @relation(fields: [createdById], references: [id])
  
  @@index([tenantId])
  @@index([category])
  @@map("finance_budgets")
}

// ==================== SURGERY MODULE ====================

enum SurgeryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SurgeryType {
  GENERAL
  ORTHOPEDIC
  CARDIAC
  NEUROSURGERY
  PLASTIC
  GYNECOLOGICAL
  UROLOGICAL
  OPHTHALMIC
  ENT
  PEDIATRIC
  EMERGENCY
  OTHER
}

model OperatingRoom {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  roomNumber  String
  floor       String?
  capacity    Int       @default(1)
  equipment   Json?     // Array of equipment
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  surgeries   Surgery[]
  
  @@unique([tenantId, roomNumber])
  @@index([tenantId])
  @@map("operating_rooms")
}

model Surgery {
  id                String        @id @default(uuid())
  tenantId          String
  surgeryNumber     String        // SUR-YYYYMM-0001
  patientId         String
  surgeonId         String
  assistantIds      String[]      @default([])
  anesthesiologistId String?
  otRoomId          String
  surgeryType       SurgeryType
  procedureName     String
  scheduledDate     DateTime
  startTime         DateTime?
  endTime           DateTime?
  status            SurgeryStatus @default(SCHEDULED)
  
  // Clinical Details
  preOpDiagnosis    String?
  postOpDiagnosis   String?
  preOpNote         String?
  postOpNote        String?
  complications     String?
  bloodLoss         Float?        // in ml
  duration          Int?          // in minutes
  
  // Equipment & Supplies
  requiredEquipment Json?         // Array of equipment needed
  implants          Json?         // Array of implants used
  
  // Documentation
  consentFormUrl    String?
  reportUrl         String?
  attachments       Json?         // Array of file URLs
  
  // Billing
  estimatedCost     Float
  actualCost        Float?
  billId            String?
  
  // Audit
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledById     String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id])
  surgeon           Staff         @relation("SurgerySurgeon", fields: [surgeonId], references: [id])
  anesthesiologist  Staff?        @relation("SurgeryAnesthesiologist", fields: [anesthesiologistId], references: [id])
  operatingRoom     OperatingRoom @relation(fields: [otRoomId], references: [id])
  bill              Bill?         @relation(fields: [billId], references: [id])
  createdBy         Staff         @relation("SurgeryCreatedBy", fields: [createdById], references: [id])
  cancelledBy       Staff?        @relation("SurgeryCancelledBy", fields: [cancelledById], references: [id])
  
  @@unique([tenantId, surgeryNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([surgeonId])
  @@index([status])
  @@index([scheduledDate])
  @@map("surgeries")
}

// Emergency Management Enums
enum EmergencySeverity {
  CRITICAL
  SERIOUS
  MODERATE
  STABLE
}

enum EmergencyStatus {
  WAITING
  UNDER_TREATMENT
  ADMITTED
  TRANSFERRED
  DISCHARGED
  DECEASED
}

enum ArrivalMode {
  AMBULANCE
  WALK_IN
  REFERRED
  POLICE
  OTHER
}

// Emergency Case Model
model EmergencyCase {
  id                  String            @id @default(cuid())
  emergencyNumber     String
  tenantId            String
  
  // Patient Information
  patientId           String?
  quickName           String?
  quickAge            Int?
  quickGender         String?
  quickContact        String?
  quickAddress        String?
  
  // Triage Information
  severity            EmergencySeverity
  chiefComplaint      String
  arrivalMode         ArrivalMode
  arrivalTime         DateTime          @default(now())
  firstResponderId    String?
  triageNurseId       String?
  attendingDoctorId   String?
  
  // Vitals
  bloodPressure       String?
  heartRate           Int?
  temperature         Float?
  respiratoryRate     Int?
  oxygenSaturation    Int?
  
  // Clinical Information
  primaryDiagnosis    String?
  secondaryDiagnosis  String?
  allergies           String?
  currentMedications  String?
  medicalHistory      String?
  
  // Treatment Information
  progressNotes       Json?             // Array of SOAP notes
  interventions       Json?             // Array of interventions
  investigations      Json?             // Lab/Radiology orders
  medications         Json?             // Emergency medications
  
  // Status & Flow
  status              EmergencyStatus   @default(WAITING)
  treatmentStartTime  DateTime?
  treatmentEndTime    DateTime?
  
  // Disposition
  admittedToIpdId     String?
  transferredTo       String?
  transferReason      String?
  dischargeTime       DateTime?
  dischargeSummary    String?
  dischargeAdvice     String?
  followUpDate        DateTime?
  
  // Death Information
  deathTime           DateTime?
  causeOfDeath        String?
  deathCertificateUrl String?
  
  // Billing
  billId              String?
  estimatedCost       Float?
  actualCost          Float?
  
  // Audit
  createdById         String
  updatedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  // Relations
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  patient             Patient?          @relation(fields: [patientId], references: [id])
  firstResponder      Staff?            @relation("EmergencyFirstResponder", fields: [firstResponderId], references: [id])
  triageNurse         Staff?            @relation("EmergencyTriageNurse", fields: [triageNurseId], references: [id])
  attendingDoctor     Staff?            @relation("EmergencyAttendingDoctor", fields: [attendingDoctorId], references: [id])
  admittedToIpd       IPDAdmission?     @relation(fields: [admittedToIpdId], references: [id])
  bill                Bill?             @relation(fields: [billId], references: [id])
  createdBy           Staff             @relation("EmergencyCreatedBy", fields: [createdById], references: [id])
  updatedBy           Staff?            @relation("EmergencyUpdatedBy", fields: [updatedById], references: [id])
  
  @@unique([tenantId, emergencyNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@index([severity])
  @@index([arrivalTime])
  @@map("emergency_cases")
}

// =====================================================
// INVENTORY MANAGEMENT MODULE
// =====================================================

// Inventory Enums
enum ItemCategory {
  MEDICINE
  CONSUMABLE
  EQUIPMENT
  SURGICAL
  LABORATORY
  GENERAL
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

enum RequisitionStatus {
  PENDING
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AdjustmentReason {
  DAMAGE
  LOSS
  THEFT
  SAMPLE
  EXPIRED
  CORRECTION
  OTHER
}

// Supplier Model
model Supplier {
  id              String        @id @default(cuid())
  tenantId        String
  supplierCode    String
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  gstNumber       String?
  panNumber       String?
  paymentTerms    String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]
  
  @@unique([tenantId, supplierCode])
  @@index([tenantId])
  @@map("suppliers")
}

// Inventory Item Master
model InventoryItem {
  id              String        @id @default(cuid())
  tenantId        String
  itemCode        String
  itemName        String
  category        ItemCategory
  subcategory     String?
  unit            String        // e.g., Box, Strip, Piece, Liter
  unitConversion  Json?         // e.g., {box: 10, strip: 1}
  reorderLevel    Int           @default(10)
  tax             Float         @default(0)
  brand           String?
  supplierId      String?
  description     String?
  departmentAccess Json?        // Array of department IDs with access
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  stockBatches    StockBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  requisitionItems RequisitionItem[]
  transferItems   TransferItem[]
  adjustments     StockAdjustment[]
  
  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([category])
  @@map("inventory_items")
}

// Stock Batch (for tracking batches with expiry)
model StockBatch {
  id              String        @id @default(cuid())
  tenantId        String
  itemId          String
  batchNumber     String
  departmentId    String?
  quantity        Int
  receivedQuantity Int
  issuedQuantity  Int           @default(0)
  availableQuantity Int
  costPrice       Float
  mrp             Float?
  expiryDate      DateTime?
  receivedDate    DateTime      @default(now())
  invoiceNumber   String?
  grnNumber       String?
  status          StockStatus   @default(IN_STOCK)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  department      Department?   @relation(fields: [departmentId], references: [id])
  
  @@index([tenantId])
  @@index([itemId])
  @@index([expiryDate])
  @@index([status])
  @@map("stock_batches")
}

// Purchase Order
model PurchaseOrder {
  id              String        @id @default(cuid())
  tenantId        String
  poNumber        String
  supplierId      String
  orderDate       DateTime      @default(now())
  expectedDeliveryDate DateTime?
  status          PurchaseOrderStatus @default(DRAFT)
  totalAmount     Float         @default(0)
  tax             Float         @default(0)
  grandTotal      Float         @default(0)
  notes           String?
  approvedById    String?
  approvedAt      DateTime?
  receivedAt      DateTime?
  invoiceUrl      String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  approvedBy      Staff?        @relation("POApprovedBy", fields: [approvedById], references: [id])
  createdBy       Staff         @relation("POCreatedBy", fields: [createdById], references: [id])
  items           PurchaseOrderItem[]
  
  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

// Purchase Order Items
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  receivedQuantity Int          @default(0)
  unitPrice       Float
  tax             Float         @default(0)
  totalPrice      Float
  createdAt       DateTime      @default(now())
  
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  
  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

// Departmental Requisition
model Requisition {
  id              String        @id @default(cuid())
  tenantId        String
  requisitionNumber String
  departmentId    String
  requestedById   String
  status          RequisitionStatus @default(PENDING)
  requestDate     DateTime      @default(now())
  approvedById    String?
  approvedAt      DateTime?
  issuedById      String?
  issuedAt        DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department    @relation(fields: [departmentId], references: [id])
  requestedBy     Staff         @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedBy      Staff?        @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  issuedBy        Staff?        @relation("RequisitionIssuedBy", fields: [issuedById], references: [id])
  items           RequisitionItem[]
  
  @@unique([tenantId, requisitionNumber])
  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
  @@map("requisitions")
}

// Requisition Items
model RequisitionItem {
  id              String        @id @default(cuid())
  requisitionId   String
  itemId          String
  requestedQuantity Int
  approvedQuantity Int?
  issuedQuantity  Int           @default(0)
  createdAt       DateTime      @default(now())
  
  requisition     Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  
  @@index([requisitionId])
  @@index([itemId])
  @@map("requisition_items")
}

// Stock Transfer Between Departments
model StockTransfer {
  id              String        @id @default(cuid())
  tenantId        String
  transferNumber  String
  fromDepartmentId String
  toDepartmentId  String
  requestedById   String
  status          TransferStatus @default(PENDING)
  requestDate     DateTime      @default(now())
  approvedById    String?
  approvedAt      DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromDepartment  Department    @relation("TransferFrom", fields: [fromDepartmentId], references: [id])
  toDepartment    Department    @relation("TransferTo", fields: [toDepartmentId], references: [id])
  requestedBy     Staff         @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy      Staff?        @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  items           TransferItem[]
  
  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([status])
  @@map("stock_transfers")
}

// Transfer Items
model TransferItem {
  id              String        @id @default(cuid())
  transferId      String
  itemId          String
  quantity        Int
  createdAt       DateTime      @default(now())
  
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  
  @@index([transferId])
  @@index([itemId])
  @@map("transfer_items")
}

// Stock Adjustment (for manual corrections)
model StockAdjustment {
  id              String        @id @default(cuid())
  tenantId        String
  adjustmentNumber String
  itemId          String
  departmentId    String?
  batchNumber     String?
  quantityBefore  Int
  quantityAfter   Int
  adjustmentQuantity Int
  reason          AdjustmentReason
  reasonNotes     String?
  adjustedById    String
  adjustedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  department      Department?   @relation(fields: [departmentId], references: [id])
  adjustedBy      Staff         @relation("AdjustmentBy", fields: [adjustedById], references: [id])
  
  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId])
  @@index([itemId])
  @@index([adjustedAt])
  @@map("stock_adjustments")
}
